        "jsonBody": "={\n  \"model\": \"llama-3.1-8b-instant\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an HR explanation agent. Return exactly 3 concise analytical sentences. No markdown.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ (\"The candidate received a match probability of \" + $node[\"Agent 2: XGBoost Predictor\"].json[\"match_probability\"] + \"%. Candidate features: \" + JSON.stringify($node[\"Agent 2: XGBoost Predictor\"].json[\"features_used\"]) + \". Explain why this score was given focusing on strengths and weaknesses.\").toJsonString() }}\n    }\n  ],\n  \"temperature\": 0.3\n}",
